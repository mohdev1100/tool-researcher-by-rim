# Copy to radar/.env (git-ignored). Used by `node radar/radar.mjs run --notify`.
# Telegram: create a bot with @BotFather, add it to the editors' group/channel, then put the chat id here.
RADAR_TELEGRAM_TOKEN=
RADAR_TELEGRAM_CHAT=
# Or any endpoint that accepts a JSON POST {text, date, new_direct, new_total, items}.
RADAR_WEBHOOK_URL=
# Optional API keys (free): lift the shared-IP rate limits on GitHub runners. Unset = header dropped.
S2_API_KEY=
CORE_API_KEY=
# Where this run happens: sources with "skip_on": ["github"] are skipped when RADAR_RUNNER=github (the Action sets it).
RADAR_RUNNER=local
